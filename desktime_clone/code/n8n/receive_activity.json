{
  "name": "receive-activity",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300],
      "parameters": {
        "path": "activity",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      }
    },
    {
      "name": "API Key Doğrula",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [420, 300],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.headers['x-api-key']}}",
              "operation": "equal",
              "value2": "degistir-beni"
            }
          ]
        }
      }
    },
    {
      "name": "Her Olay İçin",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [640, 200],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "name": "SQL Server'a Yaz",
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1,
      "position": [860, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activity_logs (user_id, logged_at, app_name, window_title, duration_sec, is_idle, category) VALUES ({{$json.body.user_id}}, '{{$json.timestamp}}', '{{$json.app_name}}', '{{$json.window_title}}', 1, {{$json.is_idle ? 1 : 0}}, CASE WHEN {{$json.is_idle ? 1 : 0}} = 1 THEN 'idle' ELSE 'other' END)"
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "API Key Doğrula", "type": "main", "index": 0 }]] },
    "API Key Doğrula": { "main": [[{ "node": "Her Olay İçin", "type": "main", "index": 0 }]] },
    "Her Olay İçin": { "main": [[{ "node": "SQL Server'a Yaz", "type": "main", "index": 0 }]] }
  },
  "_comment": "n8n'e import etmek için: Settings > Import Workflow > Bu JSON'u yapıştır. SQL Server credential'ını 'SQL Server'a Yaz' node'una bağla."
}
